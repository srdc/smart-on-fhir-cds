{
  "hook": "execute",
  "title": "Risk Prediction Form prefill service",
  "description": "",
  "id": "risk_prediction_form",
  "prefetch": {
    "patient": "Patient/{{context.patientId}}",
    "questionnaire": "Questionnaire?code={{config.StageUKBiobank}}",
    "phq2": "QuestionnaireResponse?patient=Patient/{{context.patientId}}&questionnaire={{config.PHQ2}}&_sort=-authored",
    "who5": "QuestionnaireResponse?patient=Patient/{{context.patientId}}&questionnaire=WHO5&_sort=-authored",
    "hdi4": "QuestionnaireResponse?patient=Patient/{{context.patientId}}&identifier={{config.HDI4}}&_sort=-authored",
    "share": "QuestionnaireResponse?patient=Patient/{{context.patientId}}&questionnaire={{config.SHARE}}&_sort=-authored",
    "bmi": "Observation?patient=Patient/{{context.patientId}}&code={{config.BMI}}&category=vital-signs&_sort=-date",
    "weight": "Observation?patient=Patient/{{context.patientId}}&code={{config.Weight}}&category=vital-signs&_sort=-date",
    "height": "Observation?patient=Patient/{{context.patientId}}&code={{config.Height}}&category=vital-signs&_sort=-date",
    "diastolic_blood_pressure": "Observation?patient=Patient/{{context.patientId}}&code={{config.DiastolicBP}}&category=vital-signs&_sort=-date",
    "systolic_blood_pressure": "Observation?patient=Patient/{{context.patientId}}&code={{config.SystolicBP}}&category=vital-signs&_sort=-date",
    "blood_pressure_panel": "Observation?patient=Patient/{{context.patientId}}&code={{config.BPPanel}}&category=vital-signs&_sort=-date",
    "waist_circumference": "Observation?patient=Patient/{{context.patientId}}&code={{config.WaistCircumference}}&category=laboratory&_sort=-date",
    "hip_circumference": "Observation?patient=Patient/{{context.patientId}}&code={{config.HipCircumference}}&category=vital-signs&_sort=-date",
    "body_fat": "Observation?patient=Patient/{{context.patientId}}&code={{config.BodyFat}}&category=vital-signs&_sort=-date",
    "crp": "Observation?patient=Patient/{{context.patientId}}&code={{config.CRP}}&category=laboratory&_sort=-date",
    "cholesterol": "Observation?patient=Patient/{{context.patientId}}&code={{config.Cholesterol}}&category=laboratory&_sort=-date",
    "cystatin_c": "Observation?patient=Patient/{{context.patientId}}&code={{config.CystatinC}}&category=laboratory&_sort=-date",
    "gamma_gt": "Observation?patient=Patient/{{context.patientId}}&code={{config.GammaGT}}&category=laboratory&_sort=-date",
    "hba1c": "Observation?patient=Patient/{{context.patientId}}&code={{config.HbA1C}}&category=laboratory&_sort=-date",
    "ldl": "Observation?patient=Patient/{{context.patientId}}&code={{config.LDL}}&category=laboratory&_sort=-date",
    "sleep_duration": "Observation?patient=Patient/{{context.patientId}}&code={{config.SleepDuration}}&category=survey&_sort=-date",
    "routine_events": "Observation?patient=Patient/{{context.patientId}}&code={{config.RoutineEvents}}&category=survey&_sort=-date",
    "smoking_status": "Observation?patient=Patient/{{context.patientId}}&code={{config.SmokingStatus}}&category=survey&_sort=-date",
    "alcohol_intake": "Observation?patient=Patient/{{context.patientId}}&code={{config.AlcoholIntake}}&category=survey&_sort=-date",
    "mood": "Observation?patient=Patient/{{context.patientId}}&code={{config.Mood}}&category=survey&_sort=-date",
    "mouth_ulcer": "Condition?patient=Patient/{{context.patientId}}&code={{config.MouthUlcer}}&_sort=-onset-date",
    "gum_pain": "Condition?patient=Patient/{{context.patientId}}&code={{config.GumPain}}&_sort=-onset-date",
    "bleeding_gums": "Condition?patient=Patient/{{context.patientId}}&code={{config.BleedingGums}}&_sort=-onset-date",
    "loose_teeth": "Condition?patient=Patient/{{context.patientId}}&code={{config.LooseTeeth}}&_sort=-onset-date",
    "toothache": "Condition?patient=Patient/{{context.patientId}}&code={{config.Toothache}}&_sort=-onset-date",
    "dentures": "Condition?patient=Patient/{{context.patientId}}&code={{config.Dentures}}&_sort=-onset-date",
    "fractured_bones": "Condition?patient=Patient/{{context.patientId}}&code={{config.FracturedBones}}&_sort=-onset-date",
    "hearing_loss": "Condition?patient=Patient/{{context.patientId}}&code={{config.HearingLoss}}&_sort=-onset-date",
    "deafness": "Condition?patient=Patient/{{context.patientId}}&code={{config.Deafness}}&_sort=-onset-date",
    "pain": "Condition?patient=Patient/{{context.patientId}}&code={{config.Pain}}&_sort=-onset-date",
    "pain_all_over_body": "Condition?patient=Patient/{{context.patientId}}&code={{config.PainAllOverBody}}&_sort=-onset-date",
    "mother_illnesses_1": "FamilyMemberHistory?patient=Patient/{{context.patientId}}&relationship=http://terminology.hl7.org/CodeSystem/v3-RoleCode|MTH&code={{config.FamilyHistory1}}&_sort=-date",
    "mother_illnesses_2": "FamilyMemberHistory?patient=Patient/{{context.patientId}}&relationship=http://terminology.hl7.org/CodeSystem/v3-RoleCode|MTH&code={{config.FamilyHistory2}}&_sort=-date",
